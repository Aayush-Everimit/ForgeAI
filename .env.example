# Copy to .env and fill in local values. Do not commit .env.

# Ports
WEB_PORT=3000
API_PORT=4000
WORKER_PORT=4001
RAG_PORT=8000

# Public Frontend Configuration (Safe for Browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
WEB_ALLOWED_ORIGINS=http://localhost:3000

# Authoritative PostgreSQL Database (Neon or Local Docker)
DATABASE_URL=jdbc:postgresql://localhost:5432/forgeai
DATABASE_USERNAME=forgeai
DATABASE_PASSWORD=forgeai_dev_password_change_me

# Redis (Sessions, Cache, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant Vector Index
QDRANT_URL=http://localhost:6333

# Internal RAG Service Communication (Never expose to browser)
RAG_BASE_URL=http://localhost:8000
RAG_INTERNAL_TOKEN=replace-with-strong-internal-service-token
RAG_CONNECT_TIMEOUT_MS=2000
RAG_READ_TIMEOUT_MS=5000
RAG_MAX_RETRIES=2

# GitHub OAuth Sign-In (Spring Security OAuth2 Client)
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
COOKIE_SECURE=false

# BYOK Envelope Encryption Key Encryption Key (KEK)
FORGEAI_KEK_SECRET=replace-with-strong-32-byte-kek-secret
FORGEAI_KEK_KEY_ID=kek-v1

# Java Background Worker Configuration
WORKER_ID=forgeai-worker-local
WORKER_POLL_INTERVAL_MS=2000
WORKER_STALE_CHECK_INTERVAL_MS=15000
WORKER_LEASE_SECONDS=60
WORKER_BASE_BACKOFF_MS=1000
